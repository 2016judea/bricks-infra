# --- Local model serving ---
# Device for sentence-transformers. "mps" = Apple Metal GPU (M5 Pro). "cpu" to force CPU.
BRICKS_INFRA_DEVICE=mps

# Local embedding + reranker models (downloaded from HuggingFace on first use, then cached).
# BGE-M3: multilingual dense embeddings, ~2.3GB, the 2026 production default. Replaces all-MiniLM-L6-v2.
BRICKS_INFRA_EMBED_MODEL=BAAI/bge-m3
# Cross-encoder reranker, ~2.3GB. Scores (query, passage) pairs far better than embedding cosine alone.
BRICKS_INFRA_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- LLM generation routing ---
# Native Ollama endpoint for the local small grunt model (must be running: `ollama serve`).
BRICKS_INFRA_OLLAMA_URL=http://localhost:11434
# Local model id as registered in Ollama (e.g. `ollama pull qwen3:14b`).
# Local-only by design — no cloud LLM tier. Heavier work falls back to Opus in bricks.
BRICKS_INFRA_LOCAL_LLM=qwen3:14b

# --- Image generation (Qwen-Image-2512 via fal.ai) ---
# Get a key at fal.ai. Renders legible embedded text / brand names better than FLUX.
BRICKS_INFRA_FAL_API_KEY=
BRICKS_INFRA_IMAGE_BASE_URL=https://fal.run
BRICKS_INFRA_IMAGE_MODEL=fal-ai/qwen-image

# --- Service ---
BRICKS_INFRA_HOST=127.0.0.1
BRICKS_INFRA_PORT=8088
